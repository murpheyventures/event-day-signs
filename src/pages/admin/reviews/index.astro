---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listReviews } from '../../../features/reviews/db';

const rawState = Astro.url.searchParams.get('state');
const filter = rawState === 'pending' || rawState === 'approved' || rawState === 'rejected' || rawState === 'hidden' ? rawState : 'all';
const reviews = await listReviews(env.DB, filter);
---

<AdminLayout title="Reviews" active="reviews">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div><h1 class="font-serif text-3xl tracking-tight">Reviews</h1><p class="mt-1 text-sm text-gray-500">Only approved reviews appear publicly.</p></div>
    <nav class="flex gap-3 text-xs uppercase tracking-widest">{['all', 'pending', 'approved', 'rejected', 'hidden'].map((item) => <a class={filter === item ? 'font-semibold text-brand' : 'text-gray-500'} href={`/admin/reviews${item === 'all' ? '' : `?state=${item}`}`}>{item}</a>)}</nav>
  </div>
  <div class="space-y-5">
    {reviews.map((review) => (
      <article class="rounded-lg border border-line bg-white/60 p-5">
        <div class="flex flex-wrap items-center justify-between gap-3"><div><span class="font-medium">{review.display_name}</span><span class="ml-3 text-xs uppercase tracking-widest text-gray-400">{review.rating}/5 · {review.format}</span></div><span class="rounded-full border border-line px-2 py-1 text-xs uppercase tracking-widest">{review.moderation_state}</span></div>
        <p class="mt-3 whitespace-pre-wrap text-sm">{review.body}</p>
        <form method="POST" action="/api/admin/reviews" class="mt-4 space-y-3"><input type="hidden" name="public_id" value={review.public_id} /><textarea name="merchant_response" rows="2" class="w-full rounded-md border border-line px-3 py-2 text-sm" placeholder="Optional merchant response">{review.merchant_response ?? ''}</textarea><div class="flex flex-wrap gap-3 text-xs uppercase tracking-widest"><button name="_action" value="approve" class="rounded-md bg-brand px-3 py-2 text-white">Approve</button><button name="_action" value="reject" class="rounded-md border border-line px-3 py-2">Reject</button><button name="_action" value="hide" class="rounded-md border border-line px-3 py-2">Hide</button></div></form>
      </article>
    ))}
    {reviews.length === 0 && <p class="rounded-md border border-line p-5 text-sm text-gray-500">No reviews in this view.</p>}
  </div>
</AdminLayout>
